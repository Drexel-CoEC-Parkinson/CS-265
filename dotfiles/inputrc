# ~/.inputrc -- readline (command-line editing) configuration.
# CS-265 starting configuration. Install as ~/.inputrc (note the leading dot).
# Together with "set -o vi" in .bashrc, this gives you vim keystrokes on the
# command line: Esc for normal mode, k/j through history, 0 $ w b cw ~ etc.

# don't beep at me
set bell-style visible

set editing-mode vi
set keymap vi

# the following line is actually
# equivalent to "\C-?": delete-char
"\e[3~": delete-char

# VT
"\e[1~": beginning-of-line
"\e[4~": end-of-line

# kvt
"\e[H":beginning-of-line
"\e[F":end-of-line

# rxvt and konsole (i.e. the KDE-app...)
"\e[7~":beginning-of-line
"\e[8~":end-of-line
